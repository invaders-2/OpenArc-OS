    "test:resource-search-ui": "npm run build && node tests/resource-search-ui.mjs",
    "test:resource-preview-ui": "npm run build && node tests/resource-preview-ui.mjs",
    "test:d3-04d": "node experiments/d3-04d/run-all.mjs",
    "test:d3-05": "node experiments/d3-05/run-all.mjs",
    "test:d4-01": "node experiments/d4-01/run-all.mjs",
    "test:d4-02a": "node experiments/d4-02a/run-all.mjs",
    "test:d4-02b": "node experiments/d4-02b/run-all.mjs",
    "test:d4-02c": "node experiments/d4-02c/run-all.mjs",
    "test:d4-03a": "node experiments/d4-03a/run-all.mjs",
    "test:d4-03b": "node experiments/d4-03b/run-all.mjs",
